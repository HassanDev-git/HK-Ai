{
  "name": "hk-ai",
  "productName": "HK-Ai",
  "description": "Secure multi-provider AI workspace with WhatsApp Web integration",
  "author": "HK-Ai",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "desktop:dev": "electron .",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=cjs --external:whatsapp-web.js --external:qrcode --external:vite --outfile=server.cjs",
    "desktop:build": "npm run build && npm run build:server && electron-builder --win nsis --x64",
    "desktop:build:dir": "npm run build && npm run build:server && electron-builder --win dir --x64"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "build": {
    "appId": "com.hkai.desktop",
    "productName": "HK-Ai",
    "asar": true,
    "files": [
      "dist/**/*",
      "server.ts",
      "server.cjs",
      "desktop/**/*",
      "desktop-assets/**/*",
      "firebase-applet-config.json",
      "package.json"
    ],
    "asarUnpack": [
      "server.ts",
      "server.cjs",
      "dist/**/*",
      "desktop-assets/**/*",
      "firebase-applet-config.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "desktop-assets"
    },
    "extraMetadata": {
      "name": "hk-ai",
      "productName": "HK-Ai"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop-assets/HK-Ai.ico",
      "signExecutable": false,
      "artifactName": "HK-Ai-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "HK-Ai",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US"
      ],
      "installerIcon": "desktop-assets/HK-Ai.ico",
      "installerHeader": "desktop-assets/installer-header.bmp",
      "installerSidebar": "desktop-assets/installer-sidebar.bmp",
      "include": "desktop/installer.nsh"
    }
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@openrouter/sdk": "^0.12.20",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.10.1",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.15.2",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^4.86.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
