# Stable secret used to encrypt each user's saved provider API configuration on the server.
# Generate a long random value and keep it unchanged across deployments.
PROVIDER_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional: override the Firebase web API key used for server-side token verification.
# If omitted, server.ts reads it from firebase-applet-config.json.
FIREBASE_WEB_API_KEY=

# Optional: persistent directory for encrypted per-user provider files.
# Use a durable private volume in production.
PROVIDER_CONFIG_DIR=

# Do not put user provider keys in this file. Users add their own keys after Firebase login.
